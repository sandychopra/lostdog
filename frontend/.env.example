# Backend API origin. Inlined into the browser bundle at build time — only PUBLIC_* vars are exposed,
# so never put secrets here.
PUBLIC_API_URL=http://localhost:4000
# For a tunnel, leave it blank (PUBLIC_API_URL=) so the app calls the API through this dev server's
# /api proxy, and set TUNNEL_URL in backend/.env.

# Optional: public hostname of a dev tunnel (e.g. ngrok) pointing at this dev server, without
# https:// — Vite blocks requests for unlisted hosts. Not exposed to the browser (no PUBLIC_ prefix).
# TUNNEL_HOST=your-subdomain.ngrok-free.dev
