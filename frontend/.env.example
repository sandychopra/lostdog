# Backend API origin. Inlined into the browser bundle at build time — only PUBLIC_* vars are exposed,
# so never put secrets here.
PUBLIC_API_URL=http://localhost:4000
# For a tunnel, leave it blank (PUBLIC_API_URL=) so the app calls the API through this dev server's
# /api proxy, and set TUNNEL_URL in backend/.env.

# Optional: public hostname of a dev tunnel (e.g. ngrok) pointing at this dev server, without
# https:// — Vite blocks requests for unlisted hosts. Not exposed to the browser (no PUBLIC_ prefix).
# TUNNEL_HOST=your-subdomain.ngrok-free.dev
# Sentry (src/instrument.ts): DSN for the foglight-innovations/lostdog-frontend project.
# Inlined into the bundle at build time (DSNs are public by design). Blank disables Sentry.
# PUBLIC_SENTRY_ENVIRONMENT defaults to Vite's mode; set PUBLIC_SENTRY_RELEASE at build time.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=
PUBLIC_SENTRY_RELEASE=
# Build-time only (never reaches the browser, never commit a real value): a Sentry auth token
# with Project: Read & Write and Release: Admin. When set, `vite build` uploads hidden source
# maps to lostdog-frontend and deletes them from dist/. Blank skips source maps entirely.
SENTRY_AUTH_TOKEN=
