# Prisma connection string for the local Postgres "lostdog" database.
# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See https://pris.ly/d/connection-strings for all connection string options.
DATABASE_URL="postgresql://lostdog_app:changeme@localhost:5432/lostdog?schema=public"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:4000"

# Set to "production" in every deployed environment: it turns on sign-in rate
# limiting and stops Express from including stack traces in error responses.
NODE_ENV=

# Number of reverse proxies/load balancers in front of the backend in production
# (usually 1), so rate limiting sees each client's real IP. Leave blank locally.
TRUST_PROXY_HOPS=

# Header the hosting platform's edge proxy sets to the real client IP, for proxies that
# don't send X-Forwarded-For (Railway: X-Real-IP). Used by both rate limiters instead of
# TRUST_PROXY_HOPS. Only set it behind such a proxy — otherwise clients can spoof it.
CLIENT_IP_HEADER=

# Production only (set by the Dockerfile): directory of the built frontend that this server
# should also serve, same-origin with /api. Leave blank in dev — Vite serves the frontend.
FRONTEND_DIST_DIR=

# Frontend origin (used for CORS and Better Auth's trustedOrigins)
FRONTEND_URL="http://localhost:3000"

# Seeded admin and volunteer accounts (backend/prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme"
SEED_VOLUNTEER_EMAIL="volunteer@example.com"
SEED_VOLUNTEER_PASSWORD="changeme"

# Photo storage. Local disk by default (UPLOADS_DIR, defaults to <repo>/backend/uploads).
# With NODE_ENV=production the backend refuses to start unless the S3_* vars (or an explicit
# UPLOADS_DIR on a persistent volume) are set — a container's own disk is wiped on deploy.
# Set all four S3_* vars to use an S3-compatible bucket instead — Cloudflare R2 in
# production. Never used under `bun test`.
#   Cloudflare R2: S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com", plus the
#     bucket name and an R2 API token's access key ID/secret (Object Read & Write,
#     scoped to that bucket).
#   To exercise the bucket code path locally, point these at a separate dev bucket
#   (e.g. `lostdog-photos-dev`) — never the production one.
# S3_REGION is optional (defaults to "auto", which R2 expects).
UPLOADS_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Email notifications (SendGrid). Leave blank in dev: emails are logged to the
# console instead of sent. To try real delivery, set all three and point
# NOTIFICATION_TO at a personal address — only production config should use the
# Google Group address. Never sends under `bun test`.
SENDGRID_API_KEY=
EMAIL_FROM=
NOTIFICATION_TO=

# Optional: public origin of a dev tunnel (e.g. ngrok) in front of the frontend, with https://.
# Added to Better Auth's trusted origins so sign-in works through it. Pair with a blank
# PUBLIC_API_URL and TUNNEL_HOST in frontend/.env.
TUNNEL_URL=

# Sentry error/trace/log reporting (backend/src/instrument.ts). Leave blank to disable.
# DSN for the foglight-innovations/lostdog-server project. Never used under `bun test`.
# SENTRY_ENVIRONMENT defaults to production/development from NODE_ENV; set SENTRY_RELEASE
# (e.g. the git SHA) at deploy time so issues link to a release; on Railway it falls back to
# RAILWAY_GIT_COMMIT_SHA.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
